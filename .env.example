# Copy to .env (git-ignored). All variables are optional: with none set the app
# runs in DEMO MODE using synthetic YouTube data and a local, no-network summarizer.
CKH_DATABASE_URL=sqlite:///./data/ckh.db
# Official YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
CKH_YOUTUBE_API_KEY=
CKH_YOUTUBE_DAILY_QUOTA=10000
# LLM: "local" (default, no network) or "anthropic"
CKH_LLM_PROVIDER=local
CKH_ANTHROPIC_API_KEY=
CKH_ANTHROPIC_MODEL=claude-sonnet-5-5
CKH_LLM_DAILY_CALL_LIMIT=50
# Cross-check search: "fixture" (synthetic corpus) or "brave"
CKH_SEARCH_PROVIDER=fixture
CKH_BRAVE_API_KEY=
CKH_ALLOW_SIGNUP=true
CKH_ENABLE_SCHEDULER=false
